{
  "name": "auth-gate",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "shellcheck -x scripts/setup-and-deploy/*.sh tools/wt/*.sh tools/wt/test/*.sh .claude/statusline.sh .claude/hooks/*.sh",
