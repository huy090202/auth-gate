    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.13.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
